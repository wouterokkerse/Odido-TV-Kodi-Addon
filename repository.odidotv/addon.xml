<?xml version="1.0" encoding="UTF-8"?>
<addon id="repository.odidotv" name="Odido TV Repository" version="1.0.0" provider-name="wouterokkerse">
  <requires><import addon="xbmc.addon" version="12.0.0"/></requires>
  <extension point="xbmc.addon.repository" name="Odido TV Repository">
    <dir>
      <info compressed="false">https://raw.githubusercontent.com/wouterokkerse/Odido-TV-Kodi-Addon/kodi-repository/addons.xml</info>
      <checksum>https://raw.githubusercontent.com/wouterokkerse/Odido-TV-Kodi-Addon/kodi-repository/addons.xml.md5</checksum>
      <datadir zip="true">https://raw.githubusercontent.com/wouterokkerse/Odido-TV-Kodi-Addon/kodi-repository/</datadir>
    </dir>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Updates for the unofficial Odido TV add-on</summary>
    <summary lang="nl_NL">Updates voor de onofficiële Odido TV-addon</summary>
    <description lang="en_GB">Install and update Odido TV through Kodi. Packages are published from wouterokkerse/Odido-TV-Kodi-Addon on GitHub.</description>
    <description lang="nl_NL">Installeer en update Odido TV via Kodi. Pakketten worden gepubliceerd vanuit wouterokkerse/Odido-TV-Kodi-Addon op GitHub.</description>
    <platform>all</platform><license>GPL-3.0-or-later</license>
    <assets><icon>icon.png</icon></assets>
  </extension>
</addon>
