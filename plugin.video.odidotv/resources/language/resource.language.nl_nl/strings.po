msgctxt "#30091"
msgid "This programme has not started yet."
msgstr "Dit programma is nog niet begonnen."

msgctxt "#30092"
msgid "This programme has ended and this channel does not offer replay."
msgstr "Dit programma is afgelopen en deze zender biedt geen terugkijken."

msgctxt "#30083"
msgid "Start live channels at"
msgstr "Livezenders starten op"

msgctxt "#30084"
msgid "Play from beginning of live buffer"
msgstr "Afspelen vanaf begin livebuffer"

msgctxt "#30085"
msgid "Live"
msgstr "Live"

msgctxt "#30086"
msgid "Beginning of live buffer"
msgstr "Begin van livebuffer"

msgctxt "#30087"
msgid "Watch live"
msgstr "Live kijken"

msgctxt "#30089"
msgid "Playback"
msgstr "Afspelen"

msgctxt "#30090"
msgid "Rewind is limited to the history available in the live stream."
msgstr "Terugspoelen is beperkt tot de beschikbare geschiedenis in de livestream."

msgctxt "#30082"
msgid "IPTV Simple instance settings saved"
msgstr "Instantie-instellingen IPTV Simple opgeslagen"

msgctxt "#30080"
msgid "Install IPTV Simple Client from Kodi PVR clients first, then retry setup."
msgstr "Installeer eerst IPTV Simple Client via de PVR-clients van Kodi en probeer opnieuw."

msgctxt "#30081"
msgid "An IPTV Simple instance is configured for IPTV Manager. Channels and guide will now refresh. Restart Kodi after the refresh if the TV list stays empty."
msgstr "Een IPTV Simple-instantie is ingesteld voor IPTV Manager. Zenders en gids worden nu vernieuwd. Herstart Kodi na het vernieuwen als de tv-lijst leeg blijft."

msgctxt "#30079"
msgid "Install and enable IPTV Manager first, then retry."
msgstr "Installeer en activeer eerst IPTV Manager en probeer opnieuw."

msgctxt "#30071"
msgid "Check Kodi TV integration"
msgstr "Kodi TV-integratie controleren"

msgctxt "#30072"
msgid "Manager playlist file exists"
msgstr "Afspeellijst van Manager aanwezig"

msgctxt "#30073"
msgid "Manager guide file exists"
msgstr "Gidsbestand van Manager aanwezig"

msgctxt "#30074"
msgid "Channel export"
msgstr "Zenderexport"

msgctxt "#30075"
msgid "Guide export"
msgstr "Gidsexport"

msgctxt "#30076"
msgid "Yes"
msgstr "Ja"

msgctxt "#30077"
msgid "No"
msgstr "Nee"

msgctxt "#30078"
msgid "IPTV integration error"
msgstr "Fout IPTV-integratie"

msgctxt "#30060"
msgid "Kodi TV / IPTV Manager"
msgstr "Kodi TV / IPTV Manager"

msgctxt "#30061"
msgid "Enable Kodi TV integration"
msgstr "Kodi TV-integratie inschakelen"

msgctxt "#30062"
msgid "Choose Kodi TV channels"
msgstr "Kodi TV-zenders kiezen"

msgctxt "#30063"
msgid "Enable and refresh channels and guide now"
msgstr "Inschakelen en zenders/gids nu vernieuwen"

msgctxt "#30064"
msgid "Configure IPTV Simple automatically"
msgstr "IPTV Simple automatisch instellen"

msgctxt "#30065"
msgid "Open IPTV Manager settings"
msgstr "Instellingen IPTV Manager openen"

msgctxt "#30066"
msgid "Install IPTV Manager"
msgstr "IPTV Manager installeren"

msgctxt "#30067"
msgid "Replay guide days (including today)"
msgstr "Dagen in terugkijkgids (inclusief vandaag)"

msgctxt "#30068"
msgid "Sign in first. Initial guide import can take several minutes. Tomorrow is also included."
msgstr "Log eerst in. De eerste gidsimport kan enkele minuten duren. Morgen wordt ook meegenomen."

msgctxt "#30070"
msgid "Use all Kodi TV channels"
msgstr "Alle Kodi TV-zenders gebruiken"

msgctxt "#30052"
msgid "The addon encountered an internal error. Please report the full code below."
msgstr "Er is een interne fout in de add-on opgetreden. Meld de volledige code hieronder."

msgctxt "#30001"
msgid "Live TV"
msgstr "Live tv"

msgctxt "#30002"
msgid "Replay / TV guide"
msgstr "Terugkijken / tv-gids"

msgctxt "#30005"
msgid "Search channels"
msgstr "Zenders zoeken"

msgctxt "#30006"
msgid "My list (this device)"
msgstr "Mijn lijst (dit apparaat)"

msgctxt "#30007"
msgid "Watch later (this device)"
msgstr "Kijk later (dit apparaat)"

msgctxt "#30008"
msgid "Sign in"
msgstr "Inloggen"

msgctxt "#30009"
msgid "Sign out"
msgstr "Uitloggen"

msgctxt "#30010"
msgid "Settings"
msgstr "Instellingen"

msgctxt "#30011"
msgid "Export diagnostics"
msgstr "Diagnostiek opslaan"

msgctxt "#30012"
msgid "No items found."
msgstr "Geen items gevonden."

msgctxt "#30015"
msgid "Odido TV customer number"
msgstr "Klantnummer Odido TV"

msgctxt "#30016"
msgid "Odido TV PIN"
msgstr "Pincode Odido TV"

msgctxt "#30017"
msgid "Signed in."
msgstr "Ingelogd."

msgctxt "#30018"
msgid "Sign in with your TV customer number and TV PIN from Mijn Odido."
msgstr "Log in met je TV-klantnummer en TV-pincode uit Mijn Odido."

msgctxt "#30020"
msgid "Odido TV could not complete this request. Check your connection and subscription. This experimental build still needs subscriber testing."
msgstr "Odido TV kon dit verzoek niet uitvoeren. Controleer je verbinding en abonnement. Deze experimentele versie moet nog met een abonnement worden getest."

msgctxt "#30021"
msgid "Add to My list"
msgstr "Toevoegen aan Mijn lijst"

msgctxt "#30022"
msgid "Add to Watch later"
msgstr "Toevoegen aan Kijk later"

msgctxt "#30023"
msgid "Remove from this list"
msgstr "Verwijderen uit deze lijst"

msgctxt "#30024"
msgid "List updated."
msgstr "Lijst bijgewerkt."

msgctxt "#30025"
msgid "Today"
msgstr "Vandaag"

msgctxt "#30026"
msgid "Widevine or InputStream Adaptive is unavailable on this device."
msgstr "Widevine of InputStream Adaptive is niet beschikbaar op dit apparaat."

msgctxt "#30027"
msgid "Your session expired or access was refused. Sign in again and check your TV subscription."
msgstr "Je sessie is verlopen of toegang is geweigerd. Log opnieuw in en controleer je TV-abonnement."

msgctxt "#30028"
msgid "Session removed from this device."
msgstr "Sessie verwijderd van dit apparaat."

msgctxt "#30030"
msgid "Diagnostics saved (no credentials or playback URLs):"
msgstr "Diagnostiek opgeslagen (zonder inloggegevens of afspeel-URL’s):"

msgctxt "#30032"
msgid "Not yet broadcast"
msgstr "Nog niet uitgezonden"

msgctxt "#30035"
msgid "Current programme information is unavailable."
msgstr "Informatie over het huidige programma is niet beschikbaar."

msgctxt "#30040"
msgid "About this addon"
msgstr "Over deze addon"

msgctxt "#30045"
msgid "Experimental — Kodi 21.2; PIN is not saved"
msgstr "Experimenteel — Kodi 21.2; pincode wordt niet opgeslagen"

msgctxt "#30046"
msgid "Use your TV customer number and PIN, not your Mijn Odido password"
msgstr "Gebruik je TV-klantnummer en pincode, niet je Mijn Odido-wachtwoord"

msgctxt "#30047"
msgid "Device name"
msgstr "Apparaatnaam"

msgctxt "#30048"
msgid "Device name is sent at the next sign-in"
msgstr "Apparaatnaam wordt bij de volgende login meegestuurd"

msgctxt "#30049"
msgid "Odido refused registration because of its device limit. Manage your registered devices in the official Odido service, then retry. Naming this device does not free a slot; this addon keeps the same device ID."
msgstr "Odido heeft registratie geweigerd vanwege de apparaatlimiet. Beheer je geregistreerde apparaten via de officiële Odido-dienst en probeer opnieuw. Een apparaatnaam maakt geen plek vrij; deze addon behoudt hetzelfde apparaat-ID."

msgctxt "#30050"
msgid "Restart Kodi completely to start the updated playback service, then try the channel again."
msgstr "Sluit Kodi volledig af en start opnieuw om de bijgewerkte afspeeldienst te starten. Probeer de zender daarna opnieuw."

msgctxt "#30051"
msgid "Last playback error"
msgstr "Laatste afspeelfout"
